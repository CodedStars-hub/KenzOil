# Web3Forms access key — get one free at https://web3forms.com
# Copy this file to .env.local and paste the key in.
# It's safe to expose client-side (NEXT_PUBLIC_): Web3Forms access keys
# are designed to be used from the browser and are rate/domain limited
# on their end, not secret credentials.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
